PORT=5000
FRONTEND_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=
BETTER_AUTH_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MONGODB_URI=mongodb://127.0.0.1:27017/gearrent
IMGBB_API_KEY=your_imgbb_api_key
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Use Stripe test-mode credentials locally; never place these in frontend env files.
STRIPE_SECRET_KEY=
# Set from `stripe listen --events checkout.session.completed,checkout.session.expired --forward-to http://localhost:5000/api/payments/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=
